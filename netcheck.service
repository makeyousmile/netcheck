[Unit]
Description=NetCheck - IP and Port Availability Monitor with Telegram Alerts
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/netcheck
ExecStart=/root/netcheck/netcheck -port 8088 -data /root/netcheck/data
Restart=always
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
